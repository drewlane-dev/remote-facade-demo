<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrderBook.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The typed client, used from a WEB APP rather than a test. Nothing about it
      is test-specific: it speaks the facade protocol, and this is what a
      front-end for a containerised backend looks like.
    -->
    <PackageReference Include="RemoteFacade.Client" Version="3.2.0" />
  </ItemGroup>

</Project>
