<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="Testcontainers" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The application, so the tests hold the same interfaces the container serves. -->
    <ProjectReference Include="..\..\src\OrderBook\OrderBook.csproj" />
    <!-- The typed client. Its package also ships the plugin-publish target used below. -->
    <PackageReference Include="RemoteClass.Client" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      This one line replaces a hand-written MSBuild target. RemoteClass.Client's
      package ships build/RemoteClass.Client.targets, which NuGet imports
      automatically, and it publishes each named project into
      $(OutDir)plugin/<ProjectName>/ where the fixture looks for it.

      A publish rather than a plain copy, because the container loads a publish
      folder: it needs the dependency assemblies sitting beside the library.
    -->
    <RemoteClassPlugin Include="..\..\src\OrderBook\OrderBook.csproj" />
  </ItemGroup>

</Project>
