<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="Testcontainers" Version="4.6.0" />

    <!-- The application lives in this project now, so its dependencies do too. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />

    <!--
      The typed client. Note there is no <RemoteFacadePlugin> item: that exists to
      publish a SEPARATE library into a folder the container can load, and this
      project cannot be its own plugin — the target runs after Build and needs
      Publish, which needs Build, so MSBuild rejects it with MSB4006.
      Because the startup and facade live here, the fixture points the container
      at this project's own output directory instead.
    -->
    <PackageReference Include="RemoteFacade.Client" Version="3.2.0" />
    <!--
      The Testcontainers extensions. A separate package so RemoteFacade.Client
      stays free of any container dependency; referenced alongside it, not
      instead of it, because NuGet does not flow BUILD assets transitively and
      the client ships an MSBuild target.
    -->
    <PackageReference Include="RemoteFacade.Testcontainers" Version="3.2.0" />
    <!--
      The browser runs in a CONTAINER, not on this machine, so nothing has to be
      installed with `playwright install`. The client version must match the
      image tag: Playwright's wire protocol is not stable across versions and a
      mismatch fails at ConnectAsync with a version error.
    -->
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

</Project>
